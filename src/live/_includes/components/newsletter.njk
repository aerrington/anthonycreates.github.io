<footer class="newsletter-footer">
  <div class="newsletter-footer__inner">
    <div class="newsletter-footer__copy">
      <p class="newsletter-footer__signoff">Notes from Anthony’s desk.</p>
      <p>Occasional emails about what I’m working on, what I’m discovering, and interesting ideas I come across. I hope they might support your own creativity too.</p>
    </div>

    <div class="newsletter-footer__signup">
      {% if site.newsletterAction %}
        <form action="{{ site.newsletterAction }}" method="post">
          <label class="visually-hidden" for="newsletter-email">Email address</label>
          <input id="newsletter-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required>
          <input name="embed" type="hidden" value="1">
          <input name="tag" type="hidden" value="live-site">
          <button type="submit">Join</button>
        </form>
        <p class="newsletter-status">You’ll receive an email to confirm. Unsubscribe anytime.</p>
      {% else %}
        <div class="newsletter-placeholder" aria-describedby="newsletter-status">
          <span aria-hidden="true">you@example.com</span>
          <span aria-hidden="true">Join</span>
        </div>
        <p id="newsletter-status" class="newsletter-status">{{ site.newsletterName }} signup will open before launch.</p>
      {% endif %}
      <p class="newsletter-rss">Or subscribe by <a href="/live/feed.xml">RSS</a>.</p>
    </div>
  </div>
</footer>
