{% set project = entry.data.projectDetails[0] %}
<div class="paper-sheet">
<article class="stream-entry" style="--project-colour: {{ project.colour or '#6B6560' }}">
  <img class="sheet-watermark" src="{{ entry.data.kindDetails.asset }}" alt="" aria-hidden="true">
  <img class="entry-kind-mark" src="{{ entry.data.kindDetails.asset }}" alt="" aria-hidden="true">
  <div class="sheet-content">
  <div class="entry-meta">
    <span class="entry-kind-label">{{ entry.data.kindDetails.label }}</span>
    <time datetime="{{ entry.date | isoDate }}">{{ entry.date | displayDate }}</time>
    {% if not practiceListing %}
      {% for item in entry.data.projectDetails %}
        <span class="entry-project"><span class="project-dot" style="--project-colour: {{ item.colour }}" aria-hidden="true"></span>{{ item.name }}</span>
      {% else %}<a href="/live/practice/">The practice</a>{% endfor %}
    {% endif %}
  </div>

  <h2><a href="{{ entry.url }}">{{ entry.data.title }}</a></h2>

  {% if entry.data.streamPreview %}
    <div class="stream-entry__teaser{% if entry.data.image %} stream-entry__teaser--with-media{% endif %}">
      {% if entry.data.image %}
        <figure class="stream-entry__media stream-entry__media--compact">
          <a href="{{ entry.url }}"><img src="{{ entry.data.image }}" alt="{{ entry.data.imageAlt or '' }}"></a>
        </figure>
      {% endif %}
      <div class="stream-entry__teaser-copy">
        <div class="stream-entry__preview{% if entry.data.streamPreview.source == 'model' %} stream-entry__preview--model{% endif %}">
          <p class="stream-entry__preview-label">
            {% if entry.data.streamPreview.source == "model" %}Preview · from the model{% else %}In this entry{% endif %}
          </p>
          <p>{{ entry.data.streamPreview.text }}</p>
        </div>
        <a class="stream-entry__read-more" href="{{ entry.url }}">Read on →</a>
      </div>
    </div>
  {% else %}
    {% if entry.data.image %}
      <figure class="stream-entry__media">
        <img src="{{ entry.data.image }}" alt="{{ entry.data.imageAlt or '' }}">
      </figure>
    {% endif %}
    <div class="stream-entry__body">
      {% set entryWords = (entry.templateContent | plainText).split(' ') %}
      {% if entryWords.length > 250 %}
        {% if 'model-text' in entry.templateContent %}
        <div class="model-text">
          <p class="model-text__label">Excerpt · includes text from the model</p>
        {% endif %}
        <p>{{ entryWords | take(250) | join(' ') }}…</p>
        {% if 'model-text' in entry.templateContent %}</div>{% endif %}
        <a class="stream-entry__read-more" href="{{ entry.url }}">Read on →</a>
      {% else %}{{ entry.templateContent | safe }}{% endif %}
    </div>
  {% endif %}

  {% if not entry.data.streamPreview and entryWords.length <= 250 %}
    <div class="reply-invitation">
      <a href="mailto:{{ site.replyEmail }}?subject=Anthony%20Creates%20Live%20reply">Reply by email</a>
      <span>{{ entry.data.kindDetails.offer | capitalize }}.</span>
    </div>
  {% endif %}
  </div>
</article>
</div>
