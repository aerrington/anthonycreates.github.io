<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="referrer" content="no-referrer">
    <title>{{ title }}{% if title != site.name %} — {{ site.name }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:type" content="{% if isLiveEntry %}article{% else %}website{% endif %}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    {% if isLiveEntry %}
      <meta property="article:published_time" content="{{ date | isoDate }}">
      <meta property="article:section" content="{{ kindDetails.label }}">
    {% endif %}
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ description or site.description }}">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&amp;family=IBM+Plex+Mono:wght@400;500&amp;family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/live/assets/live.css">
  </head>
  <body class="{{ pageClass or '' }}">
    <a class="skip-link" href="#main-content">Skip to content</a>

    <nav class="site-nav" aria-label="Primary">
      <a class="site-nav__brand" href="/">Anthony Creates</a>
      <div class="site-nav__links">
        <a href="/projects/">Projects</a>
        <a href="/live/"{% if page.url == "/live/" or isLiveEntry or page.url == "/live/practice/" %} aria-current="page"{% endif %}>Live</a>
        <a href="/live/about/"{% if page.url == "/live/about/" %} aria-current="page"{% endif %}>About</a>
      </div>
    </nav>

    <main id="main-content">
      {{ content | safe }}
    </main>

    {% include "components/newsletter.njk" %}
  </body>
</html>
