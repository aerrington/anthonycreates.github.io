---
layout: layouts/base.njk
title: Anthony Creates Live
description: A peek inside my digital sketchbook.
permalink: /live/index.html
pageClass: stream-page
---
<header class="masthead">
  <div class="masthead__lead">
    <img class="live-wordmark" src="/live/assets/drawn/live-wordmark.png" alt="Anthony Creates Live">
    <h1>A peek inside my digital sketchbook.</h1>
  </div>
  <aside class="now-scrap" aria-label="Currently">
    <div class="now-card">
      <p class="section-kicker">Now · {{ current.month }}</p>
      <p class="now-card__text">{{ current.text }}</p>
      <p class="now-card__summary">{{ collections.liveEntries.length }} entr{% if collections.liveEntries.length == 1 %}y{% else %}ies{% endif %} · <a href="/live/practice/">The practice</a>{% for project in collections.liveProjects %} · {% if project.projectUrl %}<a href="{{ project.projectUrl }}">{{ project.name }}</a>{% else %}{{ project.name }}{% endif %}{% endfor %}</p>
    </div>
  </aside>
</header>
<div class="stream-layout">
  <section class="stream-list" aria-label="Live entries">
    {% for entry in collections.liveEntries | take(3) %}
      {% include "components/stream-entry.njk" %}
    {% else %}
      <div class="paper-sheet"><div class="empty-stream"><h2>No entries yet.</h2><p>I’m still getting the first one ready.</p></div></div>
    {% endfor %}
    {% set listingEntries = collections.liveEntries %}
    {% include "components/earlier-entries.njk" %}
  </section>
  <img class="desk-divider" src="/live/assets/drawn/divider.png" alt="" aria-hidden="true">
</div>
