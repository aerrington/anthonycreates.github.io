---
layout: layouts/base.njk
title: The practice
description: Entries about working this way rather than about any one project.
permalink: /live/practice/index.html
pageClass: listing-page
---
<header class="masthead practice-masthead">
  <div class="masthead__lead">
    <a href="/live/"><img class="live-wordmark" src="/live/assets/drawn/live-wordmark.png" alt="Anthony Creates Live"></a>
    <h1>The practice</h1>
  </div>
  <div class="now-scrap"><div class="now-card practice-card">
    <p class="section-kicker"><img class="practice-mark" src="/live/assets/drawn/practice.png" alt="" aria-hidden="true"> The practice</p>
    <p class="now-card__text">Entries about working this way rather than about any one project.</p>
  </div></div>
</header>
<div class="stream-layout">
  <section class="practice-list" aria-label="Practice entries">
    {% set practiceListing = true %}
    {% for entry in collections.livePracticeEntries | take(3) %}
      {% include "components/stream-entry.njk" %}
    {% else %}
      <div class="paper-sheet"><div class="empty-stream"><h2>No published practice entries yet.</h2><p>They’ll appear here as I add them.</p></div></div>
    {% endfor %}
    {% set listingEntries = collections.livePracticeEntries %}
    {% include "components/earlier-entries.njk" %}
  </section>
  <img class="desk-divider" src="/live/assets/drawn/divider.png" alt="" aria-hidden="true">
</div>
