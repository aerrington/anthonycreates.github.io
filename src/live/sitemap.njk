---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for path in staticUrls %}
    <url><loc>{{ path | absoluteUrl(site.url) }}</loc></url>
  {% endfor %}
  <url><loc>{{ "/live/" | absoluteUrl(site.url) }}</loc></url>
  <url><loc>{{ "/live/practice/" | absoluteUrl(site.url) }}</loc></url>
  <url><loc>{{ "/live/about/" | absoluteUrl(site.url) }}</loc></url>
  {% for entry in collections.liveEntries %}
    <url><loc>{{ entry.url | absoluteUrl(site.url) }}</loc></url>
  {% endfor %}
</urlset>
